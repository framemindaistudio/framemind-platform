# FrameMind HQ — copy to .env.local for development. Never commit real values.
# Generate the secret and the logins with:  node scripts/make-hq-env.mjs --local

HQ_SESSION_SECRET=
# JSON list of logins with sha256 password hashes (written by the script)
HQ_USERS=

# The PRIVATE data repository. Leave all three empty in development to use the local data/ folders.
# Never a JOVE repository: FrameMind HQ refuses to read or write one.
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Where HQ is deployed (links in papers to sign, certificate QR codes). Dev default: http://localhost:3011
NEXT_PUBLIC_SITE_URL=
# The public studio website (defaults to the published Figma site)
NEXT_PUBLIC_WEBSITE_URL=

# Optional — printed on papers, cards and documents when set
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_LINKEDIN=

# Optional — the morning digest email (Vercel cron: /api/cron/digest)
RESEND_API_KEY=
DIGEST_FROM=
CRON_SECRET=

# Optional — set to 1 to make HQ read-only
FRAMEMIND_READONLY=
